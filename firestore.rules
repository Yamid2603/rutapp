rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function authed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return authed() && userDoc().rol == 'admin';
    }

    function myEmpresaId() {
      return userDoc().empresaId;
    }

    // ── Usuarios ───────────────────────────────────────────────────────────
    // read: el propio usuario siempre, o miembros de la misma empresa
    //       (admin necesita listar conductores; análisis IA filtra por empresa).
    // update permitido SOLO para auto-update y SIN cambiar rol/empresa/email.
    // delete bloqueado al cliente — solo Admin SDK.
    match /usuarios/{uid} {
      allow read: if authed() && (
        request.auth.uid == uid ||
        (resource.data.empresaId != null && resource.data.empresaId == myEmpresaId())
      );
      allow create: if authed() && request.auth.uid == uid;
      allow update: if authed()
        && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // ── Empresas ───────────────────────────────────────────────────────────
    match /empresas/{empresaId} {
      allow create: if authed() && request.resource.data.adminUid == request.auth.uid;
      allow read: if authed() && myEmpresaId() == empresaId;
      allow update: if authed() && myEmpresaId() == empresaId && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contadorRemisiones'])
      );
      allow delete: if false;
    }

    // ── Colecciones operativas ─────────────────────────────────────────────
    // Read filtrado por empresaId: aislamiento por empresa.
    // Las queries del cliente DEBEN incluir where('empresaId', '==', X) o Firestore las rechaza.

    match /clientes/{id} {
      allow read: if authed() && resource.data.empresaId == myEmpresaId();
      allow create, update: if authed() && request.resource.data.empresaId == myEmpresaId();
      allow delete: if false;
    }

    match /productos/{id} {
      allow read: if authed() && resource.data.empresaId == myEmpresaId();
      allow create: if authed() && request.resource.data.empresaId == myEmpresaId();
      allow update: if isAdmin() && resource.data.empresaId == myEmpresaId();
      allow delete: if false;
    }

    match /camiones/{id} {
      allow read: if authed() && resource.data.empresaId == myEmpresaId();
      allow create, update: if isAdmin() && request.resource.data.empresaId == myEmpresaId();
      allow delete: if false;
    }

    match /rutas/{id} {
      allow read: if authed() && resource.data.empresaId == myEmpresaId();
      allow create: if authed() && request.resource.data.empresaId == myEmpresaId();
      allow update: if authed() && resource.data.empresaId == myEmpresaId();
      allow delete: if false;
    }

    match /historialCliente/{id} {
      allow read: if authed() && resource.data.empresaId == myEmpresaId();
      allow create: if authed() && request.resource.data.empresaId == myEmpresaId();
      allow update: if isAdmin() && resource.data.empresaId == myEmpresaId();
      allow delete: if false;
    }

    // INTOCABLE: transacciones es create-only por diseño (registro contable
    // inmutable). El control de "ya facturado" vive aparte, en
    // facturasGeneradas (referencia por transaccionIds) — nunca se marca
    // sobre el documento de transacción mismo. No cambiar esta regla.
    match /transacciones/{id} {
      allow read: if authed() && resource.data.empresaId == myEmpresaId();
      allow create: if authed() && request.resource.data.empresaId == myEmpresaId();
      allow update, delete: if false;
    }

    // Registro de qué transacciones ya se incluyeron en una factura, para
    // que el corte del mes siguiente no vuelva a arrastrarlas — sin marcar
    // ni modificar transacciones (inmutable, ver arriba). Solo admin.
    match /facturasGeneradas/{id} {
      allow read: if isAdmin() && resource.data.empresaId == myEmpresaId();
      allow create: if isAdmin() && request.resource.data.empresaId == myEmpresaId();
      // Única transición permitida: marcar como pagada. Todo lo demás del
      // sello original (transaccionIds, total, clienteId, fechas,
      // generadoPor, fechaVencimiento) es inmutable — el pago SOLO puede
      // tocar estado/fechaPago/pagadoPor. No hay camino de vuelta a
      // 'facturada' ni forma de saltarse el estado 'facturada' inicial.
      allow update: if isAdmin() && resource.data.empresaId == myEmpresaId()
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.clienteId == resource.data.clienteId
        && request.resource.data.transaccionIds == resource.data.transaccionIds
        && request.resource.data.total == resource.data.total
        && request.resource.data.periodoDesde == resource.data.periodoDesde
        && request.resource.data.periodoHasta == resource.data.periodoHasta
        && request.resource.data.fechaGeneracion == resource.data.fechaGeneracion
        && request.resource.data.generadoPor == resource.data.generadoPor
        && request.resource.data.fechaVencimiento == resource.data.fechaVencimiento
        && resource.data.estado == 'facturada'
        && request.resource.data.estado == 'pagada';
      allow delete: if false;
    }

    // Comodato — catálogo de tipos de activo (mismo patrón que categoriasGasto)
    // y ledger de movimientos entre ubicaciones (cliente/camion/planta/externo).
    // El conductor SÍ escribe aquí (caso de uso central, a diferencia de
    // gastosEmpresa). Ledger create-only, nunca update/delete.
    match /tiposActivoComodato/{id} {
      allow read: if authed() && resource.data.empresaId == myEmpresaId();
      allow create, update: if isAdmin() && request.resource.data.empresaId == myEmpresaId();
      allow delete: if false;
    }

    match /comodatoMovimientos/{id} {
      allow read: if authed() && resource.data.empresaId == myEmpresaId();
      allow create: if authed() && request.resource.data.empresaId == myEmpresaId()
        && get(/databases/$(database)/documents/tiposActivoComodato/$(request.resource.data.tipoActivoId)).data.empresaId == myEmpresaId()
        && get(/databases/$(database)/documents/tiposActivoComodato/$(request.resource.data.tipoActivoId)).data.activo == true;
      allow update, delete: if false;
    }

    // Catálogos de gasto administrables por empresa — ID determinístico
    // ({empresaId}_{slug}) para que gastosEmpresa pueda validar con get()
    // sin necesitar una query. Nunca se eliminan, solo se desactivan
    // (activa/activo: false) para no romper el historial de gastos ya
    // guardados con esa categoría/beneficiario.
    match /categoriasGasto/{id} {
      allow read: if isAdmin() && resource.data.empresaId == myEmpresaId();
      allow create, update: if isAdmin() && request.resource.data.empresaId == myEmpresaId();
      allow delete: if false;
    }

    match /beneficiariosGasto/{id} {
      allow read: if isAdmin() && resource.data.empresaId == myEmpresaId();
      allow create, update: if isAdmin() && request.resource.data.empresaId == myEmpresaId();
      allow delete: if false;
    }

    // Gastos de empresa (contabilidad) — colección propia, separada de rutas.gastos[]
    // (esos son operativos de camión/día). Solo admin: dato financiero sensible,
    // el conductor no lo ve ni lo escribe.
    //
    // create: la categoría y el beneficiario referenciados deben existir y
    // estar activos — "desactivar" significa exactamente que ya no se puede
    // elegir para algo nuevo.
    //
    // update: si la categoría/beneficiario NO cambian respecto al gasto ya
    // guardado, se permite aunque hoy estén desactivados — corregir el monto
    // o la fecha de un gasto viejo no debe bloquearse porque su categoría se
    // desactivó después (eso rompería "nunca se elimina, solo se desactiva,
    // para no romper el historial"). Si SÍ cambian a una categoría/beneficiario
    // distinto, ese nuevo valor debe estar activo — mismo caso que create,
    // reasignar a algo desactivado no es válido.
    match /gastosEmpresa/{id} {
      allow read: if isAdmin() && resource.data.empresaId == myEmpresaId();
      allow create: if isAdmin() && request.resource.data.empresaId == myEmpresaId()
        && get(/databases/$(database)/documents/categoriasGasto/$(request.resource.data.categoriaId)).data.empresaId == myEmpresaId()
        && get(/databases/$(database)/documents/categoriasGasto/$(request.resource.data.categoriaId)).data.activa == true
        && get(/databases/$(database)/documents/beneficiariosGasto/$(request.resource.data.beneficiarioId)).data.empresaId == myEmpresaId()
        && get(/databases/$(database)/documents/beneficiariosGasto/$(request.resource.data.beneficiarioId)).data.activo == true;
      allow update: if isAdmin() && request.resource.data.empresaId == myEmpresaId()
        && (
          request.resource.data.categoriaId == resource.data.categoriaId ||
          (get(/databases/$(database)/documents/categoriasGasto/$(request.resource.data.categoriaId)).data.empresaId == myEmpresaId()
            && get(/databases/$(database)/documents/categoriasGasto/$(request.resource.data.categoriaId)).data.activa == true)
        )
        && (
          request.resource.data.beneficiarioId == resource.data.beneficiarioId ||
          (get(/databases/$(database)/documents/beneficiariosGasto/$(request.resource.data.beneficiarioId)).data.empresaId == myEmpresaId()
            && get(/databases/$(database)/documents/beneficiariosGasto/$(request.resource.data.beneficiarioId)).data.activo == true)
        );
      allow delete: if false;
    }

    // Operaciones de la cola offline que agotaron reintentos — visibles para
    // el admin, escritas por el conductor (create-only, igual que transacciones)
    match /operacionesFallidas/{id} {
      allow read: if isAdmin() && resource.data.empresaId == myEmpresaId();
      allow create: if authed() && request.resource.data.empresaId == myEmpresaId();
      allow update, delete: if false;
    }

    // ── Análisis (solo Cloud Functions escriben) ───────────────────────────
    match /analisisSemanal/{id} {
      allow read: if isAdmin() && resource.data.empresaId == myEmpresaId();
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin() && resource.data.empresaId == myEmpresaId();
      allow write: if false;
    }

    // ── Rate limit chatbot (solo Admin SDK escribe) ────────────────────────
    match /chatbotRateLimit/{id} {
      allow read, write: if false;
    }

    // ── Resumen mensual (solo Cloud Functions escriben) ────────────────────
    match /resumenMensual/{id} {
      allow read: if isAdmin() && resource.data.empresaId == myEmpresaId();
      allow write: if false;
    }

    // ── Bloquear todo lo demás ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
