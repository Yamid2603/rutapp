rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Logos de empresa — cualquier usuario autenticado puede subir/leer
    // (en onboarding el admin está autenticado pero sin doc de usuario aún)
    match /logos/{empresaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Fotos de comprobantes de transferencia
    match /transferencias/{empresaId}/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Fotos de clientes (subidas por admin-web)
    match /clientes/{clienteId}/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Comprobantes de transacciones (subidos por conductor-app al cerrar visita)
    match /transacciones/{transaccionId}/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Fotos de recibos de gastos (subidas por conductor-app)
    match /gastos/{rutaId}/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Denegar todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
